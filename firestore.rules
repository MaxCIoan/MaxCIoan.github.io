rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdminWithMfa() {
      return signedIn()
        && request.auth.token.admin == true
        && request.auth.token.firebase.sign_in_second_factor != null;
    }

    function isConversationOwner(conversationId) {
      return signedIn() && conversationId == request.auth.uid;
    }

    function isParticipant() {
      return signedIn()
        && request.auth.uid in resource.data.participants;
    }

    function validConversationCreate(conversationId) {
      return isConversationOwner(conversationId)
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 1
        && request.resource.data.participants[0] == request.auth.uid;
    }

    function validMessage() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'text',
          'senderId',
          'senderEmail',
          'senderName',
          'createdAt'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email;
    }

    function validConversationUpdate(conversationId) {
      return isConversationOwner(conversationId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastMessage',
          'updatedAt'
        ])
        && request.resource.data.userUid == resource.data.userUid
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.participants == resource.data.participants;
    }

    match /conversations/{conversationId} {
      allow create: if validConversationCreate(conversationId) || isAdminWithMfa();
      allow read, list: if isConversationOwner(conversationId) || isParticipant() || isAdminWithMfa();
      allow update: if validConversationUpdate(conversationId) || isAdminWithMfa();
      allow delete: if isAdminWithMfa();

      match /messages/{messageId} {
        allow read, list: if isConversationOwner(conversationId) || isAdminWithMfa();
        allow create: if (isConversationOwner(conversationId) || isAdminWithMfa()) && validMessage();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
